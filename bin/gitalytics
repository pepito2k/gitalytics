#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8
$LOAD_PATH.unshift(File.expand_path("#{File.dirname(__FILE__)}/../lib"))

require 'benchmark'
require 'optparse'
require 'gitalytics'

options = {
  benchmark: false,
  browser: false,
  format: 'cli',
  group_by: 'name'
}

OptionParser.new do |opts|
  opts.banner = 'Usage: gitalytics [options]'

  opts.on('-v', '--version', 'Display gem version') do
    puts "Gitalytics #{Gitalytics::VERSION}"
    exit
  end

  opts.on('-h', '--html', 'Outputs html report and displays it in default web browser') do
    options[:format] = 'html'
    options[:browser] = true
  end

  opts.on('-n', '--no-browser', 'Do not open html report in browser') do
    options[:format] = 'html'
    options[:browser] = false
  end

  opts.on('-j', '--json', 'Print a JSON summary to stdout') do
    options[:format] = 'json'
  end

  opts.on('-o', '--output FILE', "Where to write the HTML report (default: #{Gitalytics::OUTPUT_FILE})") do |file|
    options[:output] = file
  end

  opts.on('-s', '--since DATE', 'Only commits after DATE (e.g. 2024-01-01 or "6 months ago")') do |date|
    options[:since] = date
  end

  opts.on('-u', '--until DATE', 'Only commits before DATE') do |date|
    options[:until] = date
  end

  opts.on('-e', '--group-email', "Group commits by author's email address") do
    options[:group_by] = 'email'
  end

  opts.on('-b', '--benchmark', 'Benchmark gitalytics') do
    options[:benchmark] = true
  end
end.parse!

if options[:benchmark]
  puts(Benchmark.measure { Gitalytics.analyze(options) })
else
  Gitalytics.analyze(options)
end
